<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name="com.example.myapp.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="com.example.auth.ui.LoginActivity" />
        <activity android:name="com.example.auth.ui.RegisterActivity" />
        <activity android:name="com.example.calculation.ui.NewCalculationActivity" />
        <activity android:name="com.example.calculation.ui.MyCalculationsActivity" />
        <activity android:name="com.example.calculation.ui.CalculationDetailActivity" />

    </application>

</manifest>